{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://marine-debris-api.vercel.app/api/:path*"
    },
    {
      "source": "/storage/:path*",
      "destination": "https://marine-debris-api.vercel.app/storage/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
