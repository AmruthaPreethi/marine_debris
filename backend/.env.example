# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Set this to the live Vercel frontend URL after deploying the frontend
FRONTEND_URL=https://your-frontend.vercel.app

# SQLite (default) or a full PostgreSQL URL for production
DATABASE_URL=sqlite:///./marine_debris.db

# Model mode: "demo" (random detections, no GPU), "real" (requires best.pt), "auto" (tries real, falls back to demo)
MODEL_MODE=demo

# Absolute or relative path to YOLO weights (only needed when MODEL_MODE=real or auto)
MODEL_PATH=../runs/detect/five_class/weights/best.pt

# Max upload file size in bytes (default 20 MB)
MAX_UPLOAD_SIZE=20971520

# Optional: a strong random string used for any future JWT signing
SECRET_KEY=change-me-to-a-long-random-string
