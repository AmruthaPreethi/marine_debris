# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

