# Database
# =========================
*.db
*.sqlite
*.sqlite3

# =========================
# Storage / Uploaded Files
# =========================
storage/uploads/*
storage/processed/*
storage/annotated/*
storage/reports/*

# Keep folder structure
!storage/uploads/.gitkeep
!storage/processed/.gitkeep
!storage/annotated/.gitkeep
!storage/reports/.gitkeep

# =========================
# YOLO Training Outputs
# =========================

# Ignore all YOLO runs
runs/*

# Keep the trained model
!runs/detect/
!runs/detect/five_class/
!runs/detect/five_class/weights/
!runs/detect/five_class/weights/best.pt

# Ignore other YOLO weights/checkpoints
runs/detect/five_class/weights/*.pt
!runs/detect/five_class/weights/best.pt

# Ignore training-generated files
training/runs/
training/output/

# =========================
# Training Dataset
# =========================
training/dataset/
training/data/
datasets/
data/

